# ── База данни (PostgreSQL 14+) ──
DATABASE_URL="postgresql://bglearn:bglearn@localhost:5432/bglearn"

# Публичен адрес на сайта (за линкове в имейли)
APP_URL="http://localhost:3000"

# ── AI учител и генериране на уроци (Claude API) ──
# Без ключ AI функциите показват, че не са конфигурирани. Ключът стои само на сървъра — никога в git.
# Вместо стойност може файл от secret manager: ANTHROPIC_API_KEY_FILE="/run/secrets/anthropic_api_key"
# Проверка без разход: npm run config:check -- --verify-key
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
# low | medium | high
AI_EFFORT="medium"
# Лимити (невалидна стойност изключва AI, вместо да махне лимита)
AI_DAILY_MESSAGES_PER_USER="60"
AI_MONTHLY_BUDGET_USD="50"

# ── Имейл (SMTP). Без SMTP_HOST писмата се показват в /dev/mailbox (само в development) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="BG LEARN <no-reply@example.bg>"

# Показване на съдържание, което още не е проверено от преподавател (с ясен етикет)
SHOW_UNVERIFIED_CONTENT="true"

# Секрет за /api/cron/* (напомняния, pipeline за съдържание) — поне 32 знака. Генерирайте с: openssl rand -hex 32
CRON_SECRET=""

# ── Pipeline за съдържание (docs/PIPELINE.md) ──
# Контакт в User-Agent при извличането от Уикипедия (изискване на Wikimedia)
PIPELINE_CONTACT_EMAIL=""
# Генерирането на уроци използва ANTHROPIC_API_KEY и AI_MONTHLY_BUDGET_USD по-горе.

# Имейл на първия администратор (получава роля ADMIN при seed, ако съществува акаунт)
ADMIN_EMAIL=""
EMAIL_DEV_OUTBOX="false"
